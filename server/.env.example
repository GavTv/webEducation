PORT=3000
NODE_ENV=production

# Локально — DB; на хосте (Render) — DB_PROD (Neon / Supabase connection string)
DB=postgresql://user:password@localhost:5432/webeducation
DB_PROD=postgresql://user:password@host:5432/dbname?sslmode=require

# Через запятую: URL фронта (Vercel + свой домен)
CORS_ORIGINS=https://your-app.vercel.app,https://www.elbrus-chat.ru

# URL клиента для ссылок в письмах (сброс пароля → /reset-password?token=…)
# Локально совпадает с AUTH_URL на client (например http://localhost:5173)
CLIENT_URL=https://your-app.vercel.app

ACCESS_TOKEN_SECRET=your access token secret string
REFRESH_TOKEN_SECRET=your refresh token secret string
GOOGLE_CLIENT_ID=

# После деплоя один раз: npm run migrate (с NODE_ENV=production и DB_PROD)

