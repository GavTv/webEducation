PORT=3000
# Sequelize: как у преподавателя — src/db/config/database.json читает DB (development), DB_TEST (test), DB_PROD (production)
DB=postgresql://user:password@localhost:5432/webeducation
# DB_TEST=postgresql://user:password@localhost:5432/webeducation_test
# DB_PROD=postgresql://...

ACCESS_TOKEN_SECRET=your access token secret string
REFRESH_TOKEN_SECRET=your refresh token secret string
# Проверка Google ID token при POST /api/auth/google (тот же Client ID, что в OAuth NextAuth)
GOOGLE_CLIENT_ID=

# После обновления схемы (OAuth Google/GitHub и т.д.): в каталоге server выполните npm run migrate

